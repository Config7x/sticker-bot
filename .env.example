# --- Required ---
BOT_TOKEN=123456:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Comma-separated Telegram user ids of the owner/admins (exempt from locks & quota)
ADMIN_IDS=7886358210

# --- Database ---
# Dev default: sqlite file. Production example:
# DATABASE_URL=postgresql+asyncpg://stickerbot:PASSWORD@127.0.0.1:5432/stickerbot
DATABASE_URL=sqlite+aiosqlite:///./stickerbot.db

# --- Image pipeline ---
# Path to a Noto Naskh Arabic / Noto Sans Arabic TTF used for Persian text.
# Leave empty to auto-detect common system paths.
FA_FONT_PATH=
# Set to 1 to try rembg background removal when the rembg package is installed.
USE_REMBG=0

# --- Optional live image sources (leave empty to use internal sources only) ---
TENOR_API_KEY=
GIPHY_API_KEY=
